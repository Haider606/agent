
# File 10: ui/preload.js
preload_js = '''/**
 * ui/preload.js
 * Electron preload script.
 * Currently minimal — UI uses fetch() to localhost API directly.
 * Expand here if you need secure IPC channels later.
 */

const { contextBridge } = require("electron");

// Expose a minimal API to the renderer if needed in future phases
contextBridge.exposeInMainWorld("stocko", {
  version: "2.0.0",
});
'''

with open("/mnt/agents/output/stocko-print-agent/ui/preload.js", "w") as f:
    f.write(preload_js)

